# Environment configuration

# The port the NestJS server will run on
PORT=3000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bmms?schema=public"

# JWT Secret for signing access and refresh tokens
# Replace this with a strong, randomly generated string in production
JWT_SECRET="your-super-secret-jwt-key-change-me-in-production"
