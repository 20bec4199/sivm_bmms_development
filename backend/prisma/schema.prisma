model ParkingArea {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  description    String?
  type           String?       @default("INDOOR") // INDOOR, OUTDOOR, BASEMENT, ROOFTOP
  totalSlots     Int           @default(0)
  propertyNodeId String? // Links to a building or tower
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode   PropertyNode? @relation(fields: [propertyNodeId], references: [id])
  slots          ParkingSlot[]
  sessions       ParkingSession[]
  reservations   ParkingReservation[]
  securityPosts  SecurityPost[]

  @@index([organizationId])
  @@index([propertyNodeId])
  @@map("parking_areas")
}

model ParkingSlot {
  id                String              @id @default(uuid())
  organizationId    String
  areaId            String
  slotNumber        String
  code              String?
  zone              String?
  size              String?             @default("STANDARD") // STANDARD, COMPACT, LARGE, OVERSIZED
  type              String              @default("STANDARD") // STANDARD, COMPACT, HANDICAPPED, EV_CHARGING, VISITOR
  status            String              @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, BLOCKED, MAINTENANCE, OUT_OF_SERVICE
  isEv              Boolean             @default(false)
  isAccessible      Boolean             @default(false)
  isReserved        Boolean             @default(false)
  maintenanceStatus String?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  area              ParkingArea         @relation(fields: [areaId], references: [id], onDelete: Cascade)
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  allocations       ParkingAllocation[]
  history           ParkingHistory[]
  violations        ParkingViolation[]
  sessions          ParkingSession[]
  reservations      ParkingReservation[]
  permits           ParkingPermit[]
  evSessions        EVChargingSession[]

  @@unique([areaId, slotNumber])
  @@index([organizationId])
  @@index([areaId])
  @@map("parking_slots")
}

model ParkingAllocation {
  id             String        @id @default(uuid())
  organizationId String
  slotId         String
  vehicleId      String?
  userId         String? // Resident/Tenant/Owner
  visitorId      String? // If assigned to visitor
  propertyNodeId String? // The unit this slot is allocated to
  allocationType String        @default("PERMANENT") // PERMANENT, TEMPORARY, VISITOR
  isTemporary    Boolean       @default(false)
  originalSlotId String?
  temporaryReason String?
  startDate      DateTime      @default(now())
  endDate        DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot           ParkingSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?      @relation(fields: [vehicleId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])
  visitor        Visitor?      @relation(fields: [visitorId], references: [id])
  propertyNode   PropertyNode? @relation(fields: [propertyNodeId], references: [id])

  @@index([organizationId])
  @@index([slotId])
  @@index([vehicleId])
  @@index([userId])
  @@index([visitorId])
  @@index([propertyNodeId])
  @@map("parking_allocations")
}

model ParkingHistory {
  id             String       @id @default(uuid())
  organizationId String
  slotId         String
  vehicleId      String?
  checkInTime    DateTime     @default(now())
  checkOutTime   DateTime?
  status         String       @default("ACTIVE") // ACTIVE, COMPLETED
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot           ParkingSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])

  @@index([organizationId])
  @@index([slotId])
  @@index([vehicleId])
  @@map("parking_history")
}

model ParkingViolation {
  id             String       @id @default(uuid())
  organizationId String
  slotId         String?
  vehicleId      String?
  reportedById   String
  violationType  String // UNAUTHORIZED_PARKING, OVERSTAY, WRONG_SLOT, IMPROPER_PARKING
  description    String?
  fineAmount     Float?
  status         String       @default("REPORTED") // REPORTED, UNDER_REVIEW, SECURITY_NOTIFIED, WARNING_ISSUED, TOWING_REQUESTED, RESOLVED, DISMISSED
  violationDate  DateTime     @default(now())
  attachments    String[]     @default([])
  actionTaken    String?
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot           ParkingSlot? @relation(fields: [slotId], references: [id])
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  reportedBy     User         @relation("ReportedViolations", fields: [reportedById], references: [id])

  @@index([organizationId])
  @@index([slotId])
  @@index([vehicleId])
  @@index([reportedById])
  @@map("parking_violations")
}

model ParkingConfiguration {
  id                      String       @id @default(uuid())
  organizationId          String       @unique
  parkingMode             String       @default("RESIDENTIAL") // RESIDENTIAL, COMMERCIAL, OFFICE, RETAIL, HOSPITALITY, HOSPITAL, INSTITUTIONAL, INDUSTRIAL, STUDENT_HOUSING, MIXED
  allocationModel         String       @default("DEDICATED") // DEDICATED, SHARED_POOL, HYBRID, UNASSIGNED
  visitorParkingEnabled   Boolean      @default(true)
  reservationEnabled      Boolean      @default(true)
  paidParkingEnabled      Boolean      @default(false)
  evParkingEnabled        Boolean      @default(true)
  qrAccessEnabled         Boolean      @default(true)
  rfidAccessEnabled       Boolean      @default(true)
  anprEnabled             Boolean      @default(true)
  temporaryParkingEnabled Boolean      @default(true)
  violationsEnabled       Boolean      @default(true)
  subscriptionsEnabled    Boolean      @default(false)
  dynamicPricingEnabled   Boolean      @default(false)
  settings                Json?        @default("{}")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("parking_configurations")
}

model ParkingRule {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  ruleType       String // MAX_VEHICLES_PER_UNIT, MAX_ALLOCATED_BAYS, EMPLOYEE_HOURS, VISITOR_DURATION, FREE_PARKING_DURATION, HOURLY_RATE, PEAK_PRICING, VEHICLE_RESTRICTION
  conditions     Json         @default("{}")
  actions        Json         @default("{}")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("parking_rules")
}

model ParkingSession {
  id              String       @id @default(uuid())
  organizationId  String
  vehicleId       String?
  licensePlate    String
  userId          String?
  slotId          String?
  areaId          String?
  entryTime       DateTime     @default(now())
  exitTime        DateTime?
  durationMinutes Int?
  accessPoint     String?      @default("Main Gate")
  entryMethod     String       @default("MANUAL") // ANPR, RFID, QR, MOBILE, MANUAL
  exitMethod      String?
  totalAmount     Float        @default(0.0)
  paymentStatus   String       @default("WAIVED") // PENDING, PAID, WAIVED
  sessionStatus   String       @default("ACTIVE") // ACTIVE, COMPLETED, OVERSTAY, DISPUTED
  permitId        String?
  reservationId   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot            ParkingSlot? @relation(fields: [slotId], references: [id])
  area            ParkingArea? @relation(fields: [areaId], references: [id])
  vehicle         Vehicle?     @relation(fields: [vehicleId], references: [id])
  user            User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([slotId])
  @@index([vehicleId])
  @@index([userId])
  @@index([licensePlate])
  @@map("parking_sessions")
}

model ParkingReservation {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  vehicleId      String?
  slotId         String?
  areaId         String?
  startTime      DateTime
  endTime        DateTime
  parkingType    String       @default("STANDARD") // STANDARD, VISITOR, EV_CHARGING, ACCESSIBLE, VIP
  status         String       @default("CONFIRMED") // CONFIRMED, CHECKED_IN, COMPLETED, CANCELLED, EXPIRED
  qrCode         String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot           ParkingSlot? @relation(fields: [slotId], references: [id])
  area           ParkingArea? @relation(fields: [areaId], references: [id])
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([slotId])
  @@index([userId])
  @@index([startTime, endTime])
  @@map("parking_reservations")
}

model ParkingPermit {
  id             String       @id @default(uuid())
  organizationId String
  permitNumber   String
  permitType     String       @default("RESIDENT") // RESIDENT, TENANT, VISITOR, EMPLOYEE, CONTRACTOR, VIP, TEMPORARY, ACCESSIBLE, SERVICE
  userId         String?
  vehicleId      String?
  slotId         String?
  validFrom      DateTime     @default(now())
  validTo        DateTime?
  status         String       @default("ACTIVE") // ACTIVE, SUSPENDED, EXPIRED, REVOKED
  qrCode         String?
  metadata       Json?        @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot           ParkingSlot? @relation(fields: [slotId], references: [id])
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  user           User?        @relation(fields: [userId], references: [id])

  @@unique([organizationId, permitNumber])
  @@index([organizationId])
  @@index([slotId])
  @@index([userId])
  @@map("parking_permits")
}

model ParkingRate {
  id                  String       @id @default(uuid())
  organizationId      String
  name                String
  rateType            String       @default("HOURLY") // FREE, FLAT, HOURLY, DAILY, MONTHLY, SUBSCRIPTION
  baseAmount          Float        @default(0.0)
  hourlyRate          Float        @default(0.0)
  gracePeriodMinutes  Int          @default(15)
  maxDailyAmount      Float?
  overnightAmount     Float?
  overstayPenaltyRate Float?
  vehicleType         String?      @default("CAR")
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("parking_rates")
}

model ParkingAccessEvent {
  id               String       @id @default(uuid())
  organizationId   String
  eventType        String // VEHICLE_ENTRY, VEHICLE_EXIT, VEHICLE_DETECTED, ACCESS_GRANTED, ACCESS_DENIED
  source           String       @default("MANUAL") // ANPR, RFID, QR, MOBILE_APP, MANUAL
  deviceIdentifier String?
  licensePlate     String?
  confidenceScore  Float?
  bayCode          String?
  payload          Json?        @default("{}")
  timestamp        DateTime     @default(now())
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([eventType])
  @@index([licensePlate])
  @@map("parking_access_events")
}

model EVChargingSession {
  id                 String       @id @default(uuid())
  organizationId     String
  slotId             String
  vehicleId          String?
  userId             String?
  startTime          DateTime     @default(now())
  endTime            DateTime?
  energyConsumedKwh  Float        @default(0.0)
  chargingStatus     String       @default("CHARGING") // CHARGING, COMPLETED, FAULT, DISCONNECTED
  feeAmount          Float        @default(0.0)
  paymentStatus      String       @default("WAIVED") // PENDING, PAID, WAIVED
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slot               ParkingSlot  @relation(fields: [slotId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?     @relation(fields: [vehicleId], references: [id])
  user               User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([slotId])
  @@index([vehicleId])
  @@index([userId])
  @@map("ev_charging_sessions")
}

enum AlertType {
  EMERGENCY
  MAINTENANCE
  ANNOUNCEMENT
}

enum AlertAudience {
  ALL
  RESIDENTS
  STAFF
  SPECIFIC_NODE
}

model AlertBroadcast {
  id             String        @id @default(uuid())
  organizationId String
  title          String
  message        String
  type           AlertType     @default(ANNOUNCEMENT)
  priority       Priority      @default(MEDIUM)
  audience       AlertAudience @default(ALL)
  targetNodeId   String?       // Used if audience is SPECIFIC_NODE
  createdById    String
  status         String        @default("SENT") // DRAFT, SENT
  sentAt         DateTime?     @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetNode     PropertyNode? @relation(fields: [targetNodeId], references: [id])
  createdBy      User          @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([targetNodeId])
  @@index([createdById])
  @@map("alert_broadcasts")
}

