generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                   String                         @id @default(uuid())
  name                 String
  code                 String?
  type                 String?                        @default("Property Management")
  contactEmail         String?
  contactPhone         String?
  contactAddress       String?
  status               String                         @default("ACTIVE")
  subscriptionPlan     String                         @default("Enterprise")
  lastActivityAt       DateTime?
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  deletedAt            DateTime?
  industry             String?
  size                 String?
  assetCategories      AssetCategory[]
  assets               Asset[]
  auditLogs            AuditLog[]
  complaintCategories  ComplaintCategory[]
  complaints           Complaint[]
  departments          Department[]
  documentCategories   DocumentCategory[]
  documents            Document[]
  facilities           Facility[]
  facilityBookings     FacilityBooking[]
  incidents            Incident[]
  securityPosts        SecurityPost[]
  securityPostAssignments SecurityPostAssignment[]
  loginHistories       LoginHistory[]
  maintenancePlans     MaintenancePlan[]
  notifications        Notification[]
  modules              OrganizationModule[]
  packages             OrganizationPackage[]
  addons               OrganizationAddon[]
  propertyCategories   OrganizationPropertyCategory[]
  propertyTypes        OrganizationPropertyType[]
  owners               Owner[]
  patrolRoutes         PatrolRoute[]
  permissions          Permission[]
  propertyNodes        PropertyNode[]
  roles                Role[]
  technicianProfiles   TechnicianProfile[]
  tenants              Tenant[]
  unitTransferHistory  UnitTransferHistory[]
  userPropertyNodes    UserPropertyNode[]
  users                User[]
  vehicles             Vehicle[]
  visitorRegistrations VisitorRegistration[]
  visitors             Visitor[]
  workOrders           WorkOrder[]
  parkingAreas         ParkingArea[]
  parkingSlots         ParkingSlot[]
  parkingAllocations   ParkingAllocation[]
  parkingHistory       ParkingHistory[]
  parkingViolations    ParkingViolation[]
  parkingConfigurations ParkingConfiguration[]
  parkingRules         ParkingRule[]
  parkingSessions      ParkingSession[]
  parkingReservations  ParkingReservation[]
  parkingPermits       ParkingPermit[]
  parkingRates         ParkingRate[]
  parkingAccessEvents  ParkingAccessEvent[]
  evChargingSessions   EVChargingSession[]
  alertBroadcasts      AlertBroadcast[]

  @@index([deletedAt])
  @@map("organizations")
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  parentId       String?
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  users          User[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("departments")
}

model User {
  id                      String               @id @default(uuid())
  organizationId          String
  departmentId            String?
  email                   String               @unique
  emailNormalized         String               @unique
  passwordHash            String
  firstName               String
  lastName                String?
  phone                   String?
  avatarUrl               String?
  isActive                Boolean              @default(true)
  emailVerified           Boolean              @default(false)
  emailVerifiedAt         DateTime?
  isPlatformAdmin         Boolean              @default(false)
  isPermanentlyLocked     Boolean              @default(false)
  lockedUntil             DateTime?
  failedLoginCount        Int                  @default(0)
  lastFailedLoginAt       DateTime?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  createdById             String?
  updatedById             String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?
  auditLogsCreated        AuditLog[]           @relation("AuditLogActor")
  alertsCreated           AlertBroadcast[]
  comments                ComplaintComment[]
  complaintsAssigned      Complaint[]          @relation("ComplaintAssignee")
  complaints              Complaint[]          @relation("ComplaintCreator")
  deviceTokens            DeviceToken[]
  emailVerificationTokens EmailVerification[]
  facilityBookings        FacilityBooking[]
  loginHistories          LoginHistory[]
  passwordHistories       PasswordHistory[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  sessions                Session[]
  technicianProfile       TechnicianProfile?
  userPropertyNodes       UserPropertyNode[]
  securityPostAssignments SecurityPostAssignment[]
  userRoles               UserRole[]
  ownerProfile            Owner?
  tenantProfile           Tenant?
  department              Department?          @relation(fields: [departmentId], references: [id])
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrdersAssigned      WorkOrder[]          @relation("WorkOrderAssignedTo")
  workOrdersResident      WorkOrder[]          @relation("WorkOrderResident")
  parkingAllocations      ParkingAllocation[]
  reportedViolations      ParkingViolation[]   @relation("ReportedViolations")
  parkingReservations     ParkingReservation[]
  parkingPermits          ParkingPermit[]
  parkingSessions         ParkingSession[]
  evChargingSessions      EVChargingSession[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([email])
  @@index([emailNormalized])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  organizationId  String
  name            String
  description     String?
  isDefault       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  organizationId  String?
  action          String
  subject         String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([organizationId, action, subject])
  @@index([organizationId])
  @@index([action, subject])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  grantedById  String?
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String    @id @default(uuid())
  userId       String
  roleId       String
  assignedById String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([expiresAt])
  @@map("user_roles")
}

model UserPropertyNode {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  accessLevel    String       @default("READ_ONLY")
  grantedById    String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  propertyNodeId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode   PropertyNode @relation(fields: [propertyNodeId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyNodeId])
  @@index([organizationId])
  @@index([userId])
  @@index([propertyNodeId])
  @@map("user_property_nodes")
}

model Session {
  id                String                @id @default(uuid())
  userId            String
  deviceId          String?
  deviceName        String?
  deviceFingerprint String?
  ipAddress         String?
  lastIpAddress     String?
  userAgent         String?
  country           String?
  city              String?
  lastActiveAt      DateTime              @default(now())
  createdAt         DateTime              @default(now())
  expiresAt         DateTime
  isActive          Boolean               @default(true)
  revokedAt         DateTime?
  revokedReason     SessionRevokedReason?
  refreshTokens     RefreshToken[]
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@index([isActive])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String         @id @default(uuid())
  sessionId         String
  userId            String
  tokenHash         String         @unique
  familyId          String
  status            TokenStatus    @default(ACTIVE)
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime       @default(now())
  replacedByTokenId String?
  replacedBy        RefreshToken?  @relation("TokenChain", fields: [replacedByTokenId], references: [id])
  replacedFrom      RefreshToken[] @relation("TokenChain")
  session           Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verifications")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  requestedIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("password_history")
}

model LoginHistory {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  sessionId      String?
  email          String
  outcome        LoginOutcome
  ipAddress      String?
  userAgent      String?
  deviceName     String?
  country        String?
  city           String?
  failureReason  String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([email, createdAt])
  @@index([outcome, createdAt])
  @@map("login_history")
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  userName       String?
  userRole       String?
  actorId        String?
  actorEmail     String?
  module         String        @default("System")
  action         AuditAction   @default(RECORD_CREATED)
  actionType     String?
  entityType     String?
  entityId       String?
  description    String?
  oldValue       Json?
  newValue       Json?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  status         String        @default("SUCCESS")
  metadata       Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("AuditLogActor", fields: [actorId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([organizationId, action, createdAt])
  @@map("audit_logs")
}

model PropertyNode {
  id                   String                @id @default(uuid())
  organizationId       String
  parentId             String?
  name                 String
  nodeType             String
  categoryId           String?
  typeId               String?
  sizeSqft             Float?
  status               String                @default("ACTIVE")
  address              String?
  city                 String?
  state                String?
  zipCode              String?
  country              String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  metadata             Json?
  complaints           Complaint[]
  owners               Owner[]
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent               PropertyNode?         @relation("PropertyHierarchy", fields: [parentId], references: [id])
  children             PropertyNode[]        @relation("PropertyHierarchy")
  tenants              Tenant[]
  unitTransferHistory  UnitTransferHistory[]
  userPropertyNodes    UserPropertyNode[]
  vehicles             Vehicle[]
  visitorRegistrations VisitorRegistration[]
  alertBroadcasts      AlertBroadcast[]
  workOrders           WorkOrder[]
  parkingAreas         ParkingArea[]
  securityPosts        SecurityPost[]
  parkingAllocations   ParkingAllocation[]

  @@index([organizationId])
  @@index([parentId])
  @@map("property_nodes")
}

model Owner {
  id             String       @id @default(uuid())
  organizationId String
  propertyNodeId String
  firstName      String
  lastName       String
  email          String
  phone          String
  moveInDate     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode   PropertyNode @relation(fields: [propertyNodeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyNodeId])
  @@map("owners")
}

model Tenant {
  id             String       @id @default(uuid())
  organizationId String
  propertyNodeId String
  firstName      String
  lastName       String
  email          String?
  phone          String
  leaseStart     DateTime?
  leaseEnd       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode   PropertyNode @relation(fields: [propertyNodeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyNodeId])
  @@map("tenants")
}

model Vehicle {
  id                 String              @id @default(uuid())
  organizationId     String
  propertyNodeId     String
  licensePlate       String
  make               String?
  model              String?
  color              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode       PropertyNode        @relation(fields: [propertyNodeId], references: [id], onDelete: Cascade)
  parkingAllocations ParkingAllocation[]
  parkingHistory     ParkingHistory[]
  parkingViolations  ParkingViolation[]
  parkingSessions    ParkingSession[]
  parkingReservations ParkingReservation[]
  parkingPermits     ParkingPermit[]
  evChargingSessions EVChargingSession[]

  @@unique([organizationId, licensePlate])
  @@index([organizationId])
  @@index([propertyNodeId])
  @@map("vehicles")
}

model UnitTransferHistory {
  id              String       @id @default(uuid())
  organizationId  String
  propertyNodeId  String
  previousOwnerId String?
  newOwnerId      String?
  transferDate    DateTime     @default(now())
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode    PropertyNode @relation(fields: [propertyNodeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([propertyNodeId])
  @@map("unit_transfer_history")
}

model ComplaintCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  complaints     Complaint[]

  @@index([organizationId])
  @@map("complaint_categories")
}

model Complaint {
  id             String                @id @default(uuid())
  organizationId String
  propertyNodeId String?
  categoryId     String
  creatorId      String
  title          String
  description    String
  status         ComplaintStatus       @default(NEW)
  priority       Priority              @default(MEDIUM)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  assignedToId   String?
  feedbackRating Int?
  feedbackText   String?
  attachments    ComplaintAttachment[]
  comments       ComplaintComment[]
  history        ComplaintHistory[]
  assignedTo     User?                 @relation("ComplaintAssignee", fields: [assignedToId], references: [id])
  category       ComplaintCategory     @relation(fields: [categoryId], references: [id])
  creator        User                  @relation("ComplaintCreator", fields: [creatorId], references: [id])
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode   PropertyNode?         @relation(fields: [propertyNodeId], references: [id], onDelete: Cascade)
  facilityId     String?
  facility       Facility?             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  workOrders     WorkOrder[]

  @@index([organizationId])
  @@index([propertyNodeId])
  @@index([facilityId])
  @@index([categoryId])
  @@index([creatorId])
  @@index([assignedToId])
  @@map("complaints")
}

model ComplaintComment {
  id          String    @id @default(uuid())
  complaintId String
  userId      String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([complaintId])
  @@index([userId])
  @@map("complaint_comments")
}

model ComplaintAttachment {
  id          String    @id @default(uuid())
  complaintId String
  fileUrl     String
  fileName    String
  fileType    String?
  fileSize    Int?
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_attachments")
}

model ComplaintHistory {
  id          String           @id @default(uuid())
  complaintId String
  statusFrom  ComplaintStatus?
  statusTo    ComplaintStatus?
  notes       String?
  createdAt   DateTime         @default(now())
  complaint   Complaint        @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@map("complaint_history")
}

model Visitor {
  id                 String                @id @default(uuid())
  organizationId     String
  firstName          String
  lastName           String?
  phone              String?
  email              String?
  idNumber           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  registrations      VisitorRegistration[]
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parkingAllocations ParkingAllocation[]

  @@index([organizationId])
  @@map("visitors")
}

model VisitorRegistration {
  id              String        @id @default(uuid())
  organizationId  String
  visitorId       String
  propertyNodeId  String
  purpose         String?
  expectedArrival DateTime?
  requiresParking Boolean       @default(false)
  vehiclePlate    String?
  status          VisitorStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  logs            VisitorLog[]
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertyNode    PropertyNode  @relation(fields: [propertyNodeId], references: [id], onDelete: Cascade)
  visitor         Visitor       @relation(fields: [visitorId], references: [id])

  @@index([organizationId])
  @@index([visitorId])
  @@index([propertyNodeId])
  @@map("visitor_registrations")
}

model VisitorLog {
  id             String              @id @default(uuid())
  registrationId String
  checkInTime    DateTime?
  checkOutTime   DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  registration   VisitorRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("visitor_logs")
}

model Facility {
  id                   String            @id @default(uuid())
  organizationId       String
  name                 String
  facilityCode         String?
  category             String            @default("Recreation")
  description          String?
  shortDescription     String?
  imageUrl             String?
  galleryUrls          String[]          @default([])
  status               String            @default("ACTIVE") // ACTIVE, INACTIVE, TEMPORARILY_UNAVAILABLE, UNDER_MAINTENANCE, PERMANENTLY_CLOSED
  capacity             Int?
  hourlyRate           Float?
  depositAmount        Float?            @default(0)
  rules                String[]          @default([])
  contactPerson        String?
  contactNumber        String?
  buildingId           String?
  towerId              String?
  floorId              String?
  unitId               String?
  locationName         String?
  bookingConfig        Json?
  availabilitySchedule Json?
  eligibilityRules     Json?
  approvalConfig       Json?
  pricingConfig        Json?
  cancellationRules    Json?
  customFields         Json?
  maintenanceBlocks    Json?
  notificationConfig   Json?
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  organization         Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings             FacilityBooking[]
  complaints           Complaint[]
  workOrders           WorkOrder[]

  @@index([organizationId])
  @@map("facilities")
}

model FacilityBooking {
  id                String        @id @default(uuid())
  organizationId    String
  facilityId        String
  userId            String
  startTime         DateTime
  endTime           DateTime
  status            BookingStatus @default(PENDING)
  totalCost         Float?
  depositAmount     Float?
  attendeeCount     Int?          @default(1)
  notes             String?
  purpose           String?
  rejectionReason   String?
  customFieldValues Json?
  pricingBreakdown  Json?
  depositPaid       Boolean       @default(false)
  depositReturned   Boolean       @default(false)
  checkInTime       DateTime?
  checkOutTime      DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  facility          Facility      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id])
  workOrders        WorkOrder[]

  @@index([organizationId])
  @@index([facilityId])
  @@index([userId])
  @@map("facility_bookings")
}

model DocumentCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents      Document[]

  @@index([organizationId])
  @@map("document_categories")
}

model Document {
  id             String           @id @default(uuid())
  organizationId String
  categoryId     String
  title          String
  fileUrl        String
  fileType       String?
  fileSize       Int?
  version        Int              @default(1)
  uploadedById   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       DocumentCategory @relation(fields: [categoryId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([categoryId])
  @@index([uploadedById])
  @@map("documents")
}

model AssetCategory {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assets         Asset[]

  @@index([organizationId])
  @@map("asset_categories")
}

model Asset {
  id                    String          @id @default(uuid())
  organizationId        String
  categoryId            String
  name                  String
  serialNumber          String?
  purchaseDate          DateTime?
  purchasePrice         Float?
  warrantyExpiry        DateTime?
  warrantyDetails       String?
  expectedLifespanYears Int?
  status                AssetStatus     @default(ACTIVE)
  location              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  documents             AssetDocument[]
  category              AssetCategory   @relation(fields: [categoryId], references: [id])
